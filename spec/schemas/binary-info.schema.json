{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ombrabrowser.dev/schemas/binary-info.schema.json",
  "title": "Binary info",
  "description": "The result of the SDK binary_info() function.",
  "type": "object",
  "required": ["version", "platform", "installed", "source"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Engine version, for example 151.0.7922.108."
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "description": "Host platform, for example macos-arm64 or windows-x64."
    },
    "path": {
      "type": ["string", "null"],
      "description": "Resolved binary path, or null when nothing is installed."
    },
    "installed": {
      "type": "boolean",
      "description": "True only after the binary has been resolved and verified."
    },
    "source": {
      "type": "string",
      "enum": ["argument", "env", "app", "cache", "download", "none"],
      "description": "Where the binary came from."
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Verified digest, or null before verification."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "version": "151.0.7922.108",
      "platform": "macos-arm64",
      "path": "/Users/me/.ombra/engines/151.0.7922.108/Chromium.app/Contents/MacOS/Chromium",
      "installed": true,
      "source": "cache",
      "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    }
  ]
}
