{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ombrabrowser.dev/schemas/report.schema.json",
  "title": "Ombra conformance and stealth report",
  "description": "Shared report shape for wire, lifecycle, stealth, and parity runs.",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "operator",
    "sdk",
    "engine",
    "environment",
    "targets",
    "verdict"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique, sortable identifier. Example: 2026-11-16-macos-arm64-001."
    },
    "started_at": { "type": "string", "format": "date-time" },
    "operator": { "type": "string", "minLength": 1 },
    "sdk": { "$ref": "#/$defs/component" },
    "engine": { "$ref": "#/$defs/component" },
    "environment": {
      "type": "object",
      "required": ["os", "mode", "seed_hash"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["headed", "headless"] },
        "proxy_country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2, or \"direct\" when no proxy is used.",
          "pattern": "^([A-Z]{2}|direct)$"
        },
        "seed_hash": {
          "type": "string",
          "description": "Hash of the profile seed. The raw seed must never be stored.",
          "pattern": "^sha256:"
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "PASS_WITH_GAPS", "FAIL", "INCOMPLETE"]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "component": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "contract": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["id", "status", "failures"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable target ID, for example L1-01 or SI-03."
        },
        "status": {
          "type": "string",
          "enum": ["PASS", "DEGRADED", "FAIL", "UNREACHABLE"]
        },
        "failures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "known_gap": { "$ref": "#/$defs/known_gap" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "known_gap": {
      "type": "object",
      "required": ["owner", "reason", "expires"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "expires": {
          "type": "string",
          "format": "date",
          "description": "Date after which the gap must be re-reviewed or fixed."
        },
        "issue": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    }
  }
}
