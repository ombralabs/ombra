{
  "id": "launch-profile-lock",
  "title": "One profile directory, one live browser",
  "contract": "0.2.0",
  "runner": "lifecycle",
  "status": "design",
  "preconditions": [
    "engine binary available",
    "the profile name is free"
  ],
  "steps": [
    {
      "call": "launch",
      "as": "first",
      "args": {
        "headless": true,
        "profile": "conformance-lock"
      }
    },
    {
      "call": "launch",
      "as": "second",
      "args": {
        "headless": true,
        "profile": "conformance-lock"
      },
      "expect_error": "ProfileBusy"
    },
    {
      "call": "first.close"
    },
    {
      "call": "launch",
      "as": "third",
      "args": {
        "headless": true,
        "profile": "conformance-lock"
      }
    },
    {
      "call": "third.close"
    }
  ],
  "expect": [
    {
      "path": "second.error.kind",
      "equals": "ProfileBusy"
    },
    {
      "path": "third.kind",
      "equals": "native"
    }
  ]
}
